{
  "name": "silence-splitter",
  "version": "1.0.0-beta.1",
  "description": "Detect silences in MP4 files and export editable timelines for DaVinci Resolve and Premiere Pro",
  "author": "Palawizard",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Palawizard/silence-splitter",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "icons": "tsx scripts/generate-icons.ts",
    "dist": "npm run icons && npm run build && electron-builder --win nsis",
    "dist:publish": "npm run icons && npm run build && electron-builder --win nsis --publish always",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run test:epic1 && npm run test:epic2 && npm run test:epic3 && npm run test:epic4 && npm run test:epic5 && npm run test:epic7 && npm run test:epic8",
    "test:epic1": "tsx scripts/test-epic1.ts",
    "test:epic2": "tsx scripts/test-epic2.ts",
    "test:epic3": "tsx scripts/test-epic3.ts",
    "test:epic4": "tsx scripts/test-epic4.ts",
    "test:epic5": "tsx scripts/test-epic5.ts",
    "test:epic7": "tsx scripts/test-epic7.ts",
    "test:epic8": "tsx scripts/test-epic8.ts",
    "verify:resolve": "python scripts/verify-resolve-timeline.py",
    "test:timebolt": "tsx scripts/test-timebolt-regression.ts",
    "compare:timebolt": "tsx scripts/compare-timebolt-cuts.ts"
  },
  "build": {
    "appId": "com.palawizard.silence-splitter",
    "productName": "Silence Splitter",
    "artifactName": "Silence-Splitter-${version}-${arch}-setup.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Palawizard",
      "repo": "silence-splitter",
      "releaseType": "prerelease"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.3",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
